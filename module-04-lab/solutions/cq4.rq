# CQ4. Who supplied heparin sodium on 1 November 2025 but does not supply it today?
PREFIX ph: <https://example.org/pharma#>
PREFIX id: <https://example.org/id/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX prov: <http://www.w3.org/ns/prov#>

SELECT DISTINCT ?supplierName WHERE {
  ?old ph:supplier ?supplier ; ph:component id:C-HEPA ; ph:validFrom ?from ; ph:validTo ?to .
  FILTER(?from <= "2025-11-01"^^xsd:date && ?to > "2025-11-01"^^xsd:date)
  FILTER NOT EXISTS {
    ?now ph:supplier ?supplier ; ph:component id:C-HEPA ; ph:validFrom ?from2 ; ph:validTo ?to2 .
    FILTER(?from2 <= "2026-11-01"^^xsd:date && ?to2 > "2026-11-01"^^xsd:date)
  }
  ?supplier schema:name ?supplierName .
}
ORDER BY ?supplierName
