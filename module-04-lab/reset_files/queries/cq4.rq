# CQ4. Who supplied heparin sodium on 1 November 2025 but does not supply it today (1 November 2026)?
#
# TODO (exercise 4): write the query. Its shape:
#   - one supply agreement for id:C-HEPA that was in force on 2025-11-01
#     (ph:validFrom on or before that date, ph:validTo after it)
#   - FILTER NOT EXISTS { an agreement for id:C-HEPA with the SAME supplier that is in force on 2026-11-01 }
#   - return the supplier's schema:name as ?supplierName
# queries/cq1.rq shows how to test that an agreement is in force on a date.
PREFIX ph: <https://example.org/pharma#>
PREFIX id: <https://example.org/id/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX prov: <http://www.w3.org/ns/prov#>

SELECT DISTINCT ?supplierName WHERE {
  ?old ph:supplier ?supplier ; ph:component id:C-HEPA .
  ?supplier schema:name ?supplierName .
}
ORDER BY ?supplierName
