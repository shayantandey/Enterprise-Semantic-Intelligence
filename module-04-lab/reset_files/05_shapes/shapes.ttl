# SHACL shapes for the data graph. GraphDB validates every transaction against these before it commits.
# GraphDB reads shapes from the named graph <http://rdf4j.org/schema/rdf4j#SHACLShapeGraph>.
@prefix ph: <https://example.org/pharma#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .

ph:OrganizationShape a sh:NodeShape ; sh:targetClass ph:Organization ;
    sh:property [ sh:path ph:goldenKey ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:pattern "^G-(SUP|CUS)-[0-9]{4}$" ;
                  sh:message "An organization needs exactly one golden key from master data, such as G-SUP-0006." ] ;
    sh:property [ sh:path schema:name ; sh:minCount 1 ; sh:message "An organization needs a name." ] .

ph:ProductShape a sh:NodeShape ; sh:targetClass ph:Product ;
    sh:property [ sh:path ph:gtin ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^[0-9]{14}$" ;
                  sh:message "A product needs exactly one 14-digit GTIN." ] ;
    sh:property [ sh:path ph:madeAt ; sh:minCount 1 ; sh:class ph:Plant ;
                  sh:message "A product must be made at a plant that is in the graph." ] ;
    sh:property [ sh:path ph:contains ; sh:minCount 1 ; sh:class ph:Component ;
                  sh:message "A product must contain at least one known component." ] .

ph:SupplyAgreementShape a sh:NodeShape ; sh:targetClass ph:SupplyAgreement ;
    sh:property [ sh:path ph:supplier ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ph:Supplier ;
                  sh:message "A supply agreement needs exactly one supplier that is in the graph." ] ;
    sh:property [ sh:path ph:component ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ph:Component ;
                  sh:message "A supply agreement needs exactly one known component." ] ;
    sh:property [ sh:path ph:toPlant ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ph:Plant ;
                  sh:message "A supply agreement needs exactly one known plant." ] ;
    sh:property [ sh:path ph:validFrom ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ;
                  sh:message "A supply agreement needs exactly one valid-from date." ]
    # TODO 1 (exercise 5): add a property shape for ph:validTo here: exactly one value, of datatype xsd:date, with
    #         the message "A supply agreement needs exactly one valid-to date. Use 9999-12-31 when no end is known."
    #         Put " ;" after the closing bracket of the ph:validFrom shape above, then write the new shape on a
    #         line of its own before the full stop below. The ph:validFrom shape is the pattern to copy.
    .

ph:ShipmentShape a sh:NodeShape ; sh:targetClass ph:Shipment ;
    sh:property [ sh:path ph:ofProduct ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ph:Product ;
                  sh:message "A shipment needs exactly one product that is in the graph." ] ;
    sh:property [ sh:path ph:fromPlant ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ph:Plant ;
                  sh:message "A shipment needs exactly one known plant." ] ;
    sh:property [ sh:path ph:toCustomer ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ph:Customer ;
                  sh:message "A shipment needs exactly one customer that is in the graph." ] ;
    sh:property [ sh:path ph:shipDate ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ;
                  sh:message "A shipment needs exactly one valid ship date." ] ;
    sh:property [ sh:path ph:quantity ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ;
                  sh:message "A shipment needs a whole-number quantity of at least 1." ] .

ph:DisruptionNoticeShape a sh:NodeShape ; sh:targetClass ph:DisruptionNotice ;
    sh:property [ sh:path ph:aboutSupplier ; sh:minCount 1 ; sh:class ph:Supplier ;
                  sh:message "A disruption notice must name a supplier that is in the graph." ] ;
    sh:property [ sh:path <http://www.w3.org/ns/prov#wasDerivedFrom> ; sh:minCount 1 ;
                  sh:message "A disruption notice must record the document it was derived from." ] .

