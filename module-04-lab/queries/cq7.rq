# CQ7. Which customers have ever received a critical product? Uses the derived property ph:receives.
PREFIX ph: <https://example.org/pharma#>
PREFIX id: <https://example.org/id/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX prov: <http://www.w3.org/ns/prov#>

SELECT DISTINCT ?customerName WHERE {
  ?customer ph:receives ?product ; schema:name ?customerName .
  ?product ph:critical true .
}
ORDER BY ?customerName
