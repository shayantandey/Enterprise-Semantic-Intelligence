# CQ6. Which customers are exposed today to a disruption at Baltic Synthesis (id:G-SUP-0006)?
# A customer is exposed if, in the 90 days to 1 November 2026 (on or after 2026-08-03), it received a product that
# contains a component Baltic Synthesis supplies today, made at a plant that Baltic Synthesis supplies with it.
#
# TODO (exercise 9): the query below finds the affected plants and components. Extend it:
#   - ?product is ph:madeAt ?plant, ph:contains ?component and has a schema:name ?productName
#   - ?shipment is ph:ofProduct ?product, ph:toCustomer ?customer, with ph:shipDate ?shipped on or after 2026-08-03
#   - ?customer is a ph:Customer (this needs inference) and has a schema:name ?customerName
#   - return DISTINCT ?customerName ?productName, ordered by both
PREFIX ph: <https://example.org/pharma#>
PREFIX id: <https://example.org/id/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX prov: <http://www.w3.org/ns/prov#>

SELECT DISTINCT ?plant ?component WHERE {
  ?agr ph:supplier id:G-SUP-0006 ; ph:component ?component ; ph:toPlant ?plant ;
       ph:validFrom ?from ; ph:validTo ?to .
  FILTER(?from <= "2026-11-01"^^xsd:date && ?to > "2026-11-01"^^xsd:date)
}
ORDER BY ?plant ?component
