# CQ1. Which suppliers supply heparin sodium to which plants today?
PREFIX ph: <https://example.org/pharma#>
PREFIX id: <https://example.org/id/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX prov: <http://www.w3.org/ns/prov#>

SELECT ?supplierName ?plantName WHERE {
  ?agr ph:supplier ?supplier ; ph:component id:C-HEPA ; ph:toPlant ?plant ;
       ph:validFrom ?from ; ph:validTo ?to .
  FILTER(?from <= "2026-11-01"^^xsd:date && ?to > "2026-11-01"^^xsd:date)
  ?supplier schema:name ?supplierName .
  ?plant schema:name ?plantName .
}
ORDER BY ?supplierName ?plantName
