# CQ2. Which components have a single supplier today across all plants (sole-sourced)?
PREFIX ph: <https://example.org/pharma#>
PREFIX id: <https://example.org/id/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX prov: <http://www.w3.org/ns/prov#>

SELECT DISTINCT ?componentName ?supplierName WHERE {
  ?agr ph:supplier ?supplier ; ph:component ?component ; ph:validFrom ?from ; ph:validTo ?to .
  FILTER(?from <= "2026-11-01"^^xsd:date && ?to > "2026-11-01"^^xsd:date)
  FILTER NOT EXISTS {
    ?other ph:component ?component ; ph:supplier ?supplier2 ; ph:validFrom ?from2 ; ph:validTo ?to2 .
    FILTER(?supplier2 != ?supplier && ?from2 <= "2026-11-01"^^xsd:date && ?to2 > "2026-11-01"^^xsd:date)
  }
  ?component schema:name ?componentName .
  ?supplier schema:name ?supplierName .
}
ORDER BY ?componentName
