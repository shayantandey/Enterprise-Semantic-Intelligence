# CQ6. Which customers are exposed today to a disruption at Baltic Synthesis (G-SUP-0006)?
# A customer is exposed if, in the 90 days to 1 November 2026, it received a product that contains a component
# Baltic Synthesis supplies today, made at a plant that Baltic Synthesis supplies with that component.
PREFIX ph: <https://example.org/pharma#>
PREFIX id: <https://example.org/id/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX prov: <http://www.w3.org/ns/prov#>

SELECT DISTINCT ?customerName ?productName WHERE {
  ?agr ph:supplier id:G-SUP-0006 ; ph:component ?component ; ph:toPlant ?plant ;
       ph:validFrom ?from ; ph:validTo ?to .
  FILTER(?from <= "2026-11-01"^^xsd:date && ?to > "2026-11-01"^^xsd:date)
  ?product ph:madeAt ?plant ; ph:contains ?component ; schema:name ?productName .
  ?shipment ph:ofProduct ?product ; ph:toCustomer ?customer ; ph:shipDate ?shipped .
  FILTER(?shipped >= "2026-08-03"^^xsd:date)
  ?customer a ph:Customer ; schema:name ?customerName .
}
ORDER BY ?customerName ?productName
