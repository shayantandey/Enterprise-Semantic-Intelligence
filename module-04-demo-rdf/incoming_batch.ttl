@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix ph: <https://example.org/pharma#> .
@prefix id: <https://example.org/id/> .

id:AGR-101 a ph:SupplyAgreement ;
    ph:component id:C-HEPA ;
    ph:supplier id:G-SUP-0009 ;
    ph:toPlant id:PL-VIZ ;
    ph:validFrom "2026-11-15"^^xsd:date ;
    ph:validTo "9999-12-31"^^xsd:date .
id:AGR-102 a ph:SupplyAgreement ;
    ph:component id:C-STOP ;
    ph:supplier id:UNMATCHED-V-1099 ;
    ph:toPlant id:PL-AHM ;
    ph:validFrom "2026-11-15"^^xsd:date ;
    ph:validTo "9999-12-31"^^xsd:date .
id:AGR-103 a ph:SupplyAgreement ;
    ph:component id:C-MCC ;
    ph:supplier id:G-SUP-0003 ;
    ph:toPlant id:PL-GOA ;
    ph:validFrom "2026-11-15"^^xsd:date ;
    ph:validTo "31/12/2027"^^xsd:date .
id:AGR-104 a ph:SupplyAgreement ;
    ph:component id:C-GLYC ;
